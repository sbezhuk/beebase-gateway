# ==============================================================================
# BeeBase subscription-service: per-service production environment configuration
# ==============================================================================
#
# Provisioned once by an operator on the production EC2 host at:
#   /opt/beebase/config/subscription.env
#
# Permissions: mode 0600, owned by root (or whichever operator user runs deploy.sh).
# deploy.sh refuses to touch the running stack unless this file exists, is 0600,
# and has every required key below set to a non-empty value.
#
# Values in this file are secrets. They are never stored in git, a release manifest,
# a Docker image, or AWS SSM Parameter Store.

# ------------------------------------------------------------------------------
# PostgreSQL (Required)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
POSTGRES_SUBSCRIPTION_PASSWORD=

# ------------------------------------------------------------------------------
# Auth/session dependencies (Required)
# ------------------------------------------------------------------------------
# Production internal Docker network values.
AUTH_JWKS_URL=
REDIS_ADDR=

# ------------------------------------------------------------------------------
# Apple App Store (Required)
# ------------------------------------------------------------------------------
# APPLE_PRIVATE_KEY must be a single-line value compatible with Docker Compose
# env_file parsing and the subscription-service config loader.
APPLE_BUNDLE_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=

# ------------------------------------------------------------------------------
# Google Play (Required)
# ------------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON must be a single-line raw JSON object compatible
# with Docker Compose env_file parsing and option.WithCredentialsJSON.
GOOGLE_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# Logging (Optional)
# ------------------------------------------------------------------------------
# debug | info | warn | error (defaults to info if omitted)
#LOG_LEVEL=info
