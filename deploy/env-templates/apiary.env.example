# TEMPLATE ONLY for /opt/beebase/config/apiary.env - apiary-service's
# own production secrets. Never loaded by deploy.sh, Docker Compose, or
# the app directly (see docker-compose.prod.yml's env_file: entry for
# apiary-service, which reads the REAL file this template produces).
# Provision once on the EC2 host:
#   cp deploy/env-templates/apiary.env.example /opt/beebase/config/apiary.env
#   chmod 600 /opt/beebase/config/apiary.env
#   vim /opt/beebase/config/apiary.env   # fill in the real value below
#
# Mirrors beebase-apiary-service/.env.example's required-in-production
# keys - every other required variable (AUTH_JWKS_URL, REDIS_ADDR,
# HIVE_SERVICE_URL, MEDIA_SERVICE_URL, PUBLIC_BASE_URL) is non-secret
# network topology docker-compose.prod.yml already supplies via
# `environment:` (see requirement 11 in the deployment report). Never
# commit a real value - this file must only ever contain placeholders.

# PostgreSQL password for apiary-service's own database (the
# postgres-apiary container in docker-compose.prod.yml). Named to match
# beebase-apiary-service/.env.example's own POSTGRES_PASSWORD.
#
# deploy.sh also mirrors this value (by key name only, never logged)
# into the deploy-generated .../config/deploy.env, because Compose can
# only resolve the postgres-apiary container's own POSTGRES_PASSWORD and
# migrate-apiary's `-database=...` command argument via its single
# top-level --env-file, not via another service's env_file: contents -
# see docker-compose.prod.yml's header comment. deploy.env is never
# hand-edited; this file remains the one source of truth.
POSTGRES_APIARY_PASSWORD=

# ------------------------------------------------------------------------------
# Logging (Optional)
# ------------------------------------------------------------------------------
# Optional. Defaults to info when omitted.
# debug | info | warn | error (defaults to info if omitted)
#LOG_LEVEL=info
