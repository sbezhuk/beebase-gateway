# TEMPLATE ONLY for /opt/beebase/config/harvest.env -
# harvest-service's own production secrets. Never loaded by
# deploy.sh, Docker Compose, or the app directly (see
# docker-compose.prod.yml's env_file: entry for harvest-service,
# which reads the REAL file this template produces). Provision once on
# the EC2 host:
#   cp deploy/env-templates/harvest.env.example /opt/beebase/config/harvest.env
#   chmod 600 /opt/beebase/config/harvest.env
#   vim /opt/beebase/config/harvest.env   # fill in the real value below
#
# Mirrors beebase-harvest-service/.env.example's required-in-production
# keys - every other required variable (AUTH_JWKS_URL, REDIS_ADDR,
# HIVE_SERVICE_URL) is non-secret network topology docker-compose.prod.yml
# already supplies via `environment:` (see requirement 11 in the deployment
# report). Notification cleanup is required by harvest deletion and is
# supplied here. Never commit a real value - this file must only ever contain
# placeholders.

# PostgreSQL password for harvest-service's own database (the
# postgres-harvest container in docker-compose.prod.yml). Named to
# match beebase-harvest-service/.env.example's own POSTGRES_PASSWORD.
#
# deploy.sh also mirrors this value (by key name only, never logged)
# into the deploy-generated .../config/deploy.env, because Compose can
# only resolve the postgres-harvest container's own
# POSTGRES_PASSWORD and migrate-harvest's `-database=...` command
# argument via its single top-level --env-file, not via another
# service's env_file: contents - see docker-compose.prod.yml's header
# comment. deploy.env is never hand-edited; this file remains the one
# source of truth.
POSTGRES_HARVEST_PASSWORD=
INTERNAL_SERVICE_TOKEN=
NOTIFICATION_SERVICE_URL=

# ------------------------------------------------------------------------------
# Logging (Optional)
# ------------------------------------------------------------------------------
# Optional. Defaults to info when omitted.
# debug | info | warn | error (defaults to info if omitted)
#LOG_LEVEL=info
