# TEMPLATE ONLY for /opt/beebase/config/auth.env - auth-service's own
# production secrets. Never loaded by deploy.sh, Docker Compose, or the
# app directly (see docker-compose.prod.yml's env_file: entry for
# auth-service, which reads the REAL file this template produces).
# Provision once on the EC2 host:
#   cp deploy/env-templates/auth.env.example /opt/beebase/config/auth.env
#   chmod 600 /opt/beebase/config/auth.env
#   vim /opt/beebase/config/auth.env   # fill in real values below
#
# Mirrors beebase-auth-service/.env.example's required-in-production
# keys (see its internal/config/config.go Load() for the exact
# required-field list) - only the keys that have no safe default and
# that docker-compose.prod.yml doesn't already supply itself via
# `environment:` (network topology such as REDIS_ADDR, MEDIA_SERVICE_URL
# and APIARY_SERVICE_URL stays compose-owned; see requirement 11 in the
# deployment report). Never commit a real value for anything below -
# this file must only ever contain placeholders.

# PostgreSQL password for auth-service's own database (the postgres-auth
# container in docker-compose.prod.yml). Named to match
# beebase-auth-service/.env.example's own POSTGRES_PASSWORD, not a
# gateway-invented name - this file is what supplies it.
#
# deploy.sh also mirrors this value (by key name only, never logged)
# into the deploy-generated .../config/deploy.env, because Compose can
# only resolve the postgres-auth container's own POSTGRES_PASSWORD and
# migrate-auth's `-database=...` command argument via its single
# top-level --env-file, not via another service's env_file: contents -
# see docker-compose.prod.yml's header comment. deploy.env is never
# hand-edited; this file remains the one source of truth.
POSTGRES_AUTH_PASSWORD=

# base64-encoded Ed25519 private key (64 bytes) - the only key that can
# mint access tokens for the whole BeeBase deployment; every other
# service verifies against the matching public key served at this
# service's /.well-known/jwks.json. Generate with:
# (cd ../beebase-auth-service && make keygen)
JWT_PRIVATE_KEY=

# base64-encoded 32-byte AES-256 key used to encrypt TOTP (2FA) secrets
# at rest. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Optional: scopes the refresh-token cookie to a shared parent domain
# (e.g. ".beebase.club") if the deployment ever serves the frontend from
# a different subdomain than the gateway. Leave unset (or this line
# absent) for host-only, correct for the current single-domain
# deployment - see beebase-auth-service's internal/config/config.go.
#COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Logging (Optional)
# ------------------------------------------------------------------------------
# Optional. Defaults to info when omitted.
# debug | info | warn | error (defaults to info if omitted)
#LOG_LEVEL=info
