# TEMPLATE ONLY for /opt/beebase/config/media.env - media-service's own
# production secrets and storage configuration. Never loaded by
# deploy.sh, Docker Compose, or the app directly (see
# docker-compose.prod.yml's env_file: entry for media-service, which
# reads the REAL file this template produces). Provision once on the
# EC2 host:
#   cp deploy/env-templates/media.env.example /opt/beebase/config/media.env
#   chmod 600 /opt/beebase/config/media.env
#   vim /opt/beebase/config/media.env   # fill in real values below
#
# Mirrors beebase-media-service/.env.example's required-in-production
# keys - every other required variable (AUTH_JWKS_URL, REDIS_ADDR,
# PUBLIC_BASE_URL, STORAGE_REGION) is non-secret network topology
# docker-compose.prod.yml already supplies via `environment:` (see
# requirement 11 in the deployment report; STORAGE_REGION is always the
# deployment's own AWS_REGION, not something media-service picks
# independently). Never commit a real value - this file must only ever
# contain placeholders.

# PostgreSQL password for media-service's own database (the
# postgres-media container in docker-compose.prod.yml). Named to match
# beebase-media-service/.env.example's own POSTGRES_PASSWORD.
#
# deploy.sh also mirrors this value (by key name only, never logged)
# into the deploy-generated .../config/deploy.env, because Compose can
# only resolve the postgres-media container's own POSTGRES_PASSWORD and
# migrate-media's `-database=...` command argument via its single
# top-level --env-file, not via another service's env_file: contents -
# see docker-compose.prod.yml's header comment. deploy.env is never
# hand-edited; this file remains the one source of truth.
POSTGRES_PASSWORD=

# S3 bucket media-service stores uploaded files in. Owned by
# media-service (see requirement 10 in the deployment report), not
# fetched from SSM as generic infra config anymore. No AWS access
# key/secret belongs here or anywhere else: the container authenticates
# to S3 via the EC2 instance's IAM role (see terraform/modules/iam),
# resolved automatically by the AWS SDK's default credential chain.
STORAGE_BUCKET=
