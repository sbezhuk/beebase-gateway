# TEMPLATE ONLY — documents the production secrets that must exist in
# /opt/beebase/config/.env on the EC2 host before deploy.sh can run.
# Never loaded by deploy.sh, Docker Compose, or any application - copy
# it once on the host to bootstrap the real file:
#   cp deploy/.env.example /opt/beebase/config/.env
#   chmod 600 /opt/beebase/config/.env
#   vim /opt/beebase/config/.env   # fill in real values below
#
# These are the only values deploy.sh will never generate, fetch from
# AWS SSM Parameter Store, or overwrite - see deploy/lib/secrets.sh and
# this repo's README.md ("Secrets, images, 'no latest'"). Every other
# key deploy.sh needs (ECR_REGISTRY, AWS_REGION, RELEASE, each service's
# *_IMAGE_TAG, PUBLIC_DOMAIN, STORAGE_BUCKET, ...) is refreshed into this
# same file automatically on every deploy and does not belong here.
#
# Never commit real values for these - this file must only ever contain
# placeholders.

# PostgreSQL password for each of the 5 per-service databases. One
# password per database (not shared) - see docker-compose.prod.yml's
# postgres-* and migrate-* services.
POSTGRES_AUTH_PASSWORD=
POSTGRES_APIARY_PASSWORD=
POSTGRES_HIVE_PASSWORD=
POSTGRES_INSPECTION_PASSWORD=
POSTGRES_MEDIA_PASSWORD=

# base64-encoded 32-byte AES-256 key auth-service uses to encrypt TOTP
# (2FA) secrets at rest. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Private key auth-service uses to sign access/refresh JWTs. Generate
# with: (cd ../beebase-auth-service && make keygen)
JWT_PRIVATE_KEY=
