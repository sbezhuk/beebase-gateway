# BeeBase production edge: TLS termination only. Caddy is the sole
# public entry point (the security group allows inbound 80/443 from the
# whole internet - see terraform/modules/ec2-instance); it obtains and
# renews its own publicly-trusted certificate from Let's Encrypt
# automatically (ACME HTTP-01 challenge on :80, which is why that port
# must stay reachable, not just :443), with no manual cert to provision
# and no upstream proxy in front of it.
#
# gateway is never exposed directly - this is the only container with a
# published host port, and it only ever proxies to gateway:8080 on the
# internal `beebase` Docker network.

{
	# No admin API exposed - nothing needs to reach it, and it isn't
	# published to the host regardless.
	admin off
}

{$PUBLIC_DOMAIN} {
	# No explicit `tls` directive: Caddy's automatic HTTPS handles
	# certificate acquisition/renewal itself for the domain in the site
	# address above, and already includes an HTTP->HTTPS redirect on :80
	# for it - both were previously done manually (a mounted Cloudflare
	# Origin CA cert) because Cloudflare's proxy, not Caddy, terminated
	# public TLS. The ACME-obtained cert/key persist in the `caddy-data`
	# volume (see docker-compose.prod.yml), so a container restart
	# doesn't re-request a new one from Let's Encrypt every time.

	encode gzip

	reverse_proxy gateway:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}
