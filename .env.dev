# BeeBase Local Development Environment Configuration
# Use with: docker compose --env-file .env.dev -f docker-compose.dev.yml up -d

# Environment & Logging
APP_ENV=development
LOG_LEVEL=debug

# Development Ports (avoiding conflict with existing environment ports)
GATEWAY_PORT=18080
REDIS_PORT=16379
AUTH_POSTGRES_PORT=15432
APIARY_POSTGRES_PORT=15433
HIVE_POSTGRES_PORT=15434
INSPECTION_POSTGRES_PORT=15435
MEDIA_POSTGRES_PORT=15436
SUBSCRIPTION_POSTGRES_PORT=15437
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# Database Configuration (Development credentials)
POSTGRES_USER=beebase
POSTGRES_AUTH_PASSWORD=beebase
POSTGRES_APIARY_PASSWORD=beebase
POSTGRES_HIVE_PASSWORD=beebase
POSTGRES_INSPECTION_PASSWORD=beebase
POSTGRES_MEDIA_PASSWORD=beebase
POSTGRES_SUBSCRIPTION_PASSWORD=beebase
AUTH_DB_NAME=beebase_auth_dev
APIARY_DB_NAME=beebase_apiary_dev
HIVE_DB_NAME=beebase_hive_dev
INSPECTION_DB_NAME=beebase_inspection_dev
MEDIA_DB_NAME=beebase_media_dev
SUBSCRIPTION_DB_NAME=beebase_subscription_dev

# Auth Service Secrets (Development-only generated keys)
# Ed25519 64-byte private key for JWT signing
JWT_PRIVATE_KEY=wgqDmlwai/1h1bszkS1HyQBFxiPbecjXbdck/DAr8igX4YX6oY7fEKlnPx1ObjGKjRDcSdi7ixIrcT8jxe8OJA==
# 32-byte AES key for TOTP secrets
TOTP_ENCRYPTION_KEY=4v+CUCjTBWUCaPHDnijzUPPvxsFa3ZC4TJw3UvdfeEw=
TOTP_ISSUER=BeeBase-Dev

# Object Storage (Local MinIO S3-compatible service)
STORAGE_BUCKET=beebase-media-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_EC2_METADATA_DISABLED=true

# Public Base URL for media downloads via Gateway
PUBLIC_BASE_URL=http://localhost:18080
