# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Upstream base URLs. Requests are forwarded with their path and query
# untouched, so each upstream keeps routing exactly as it does when
# called directly (no path rewriting/prefix stripping happens here).
#
# For standalone `go run` against services also running on the host:
AUTH_SERVICE_URL=http://localhost:8081
APIARY_SERVICE_URL=http://localhost:8082
HIVE_SERVICE_URL=http://localhost:8083
INSPECTION_SERVICE_URL=http://localhost:8084
MEDIA_SERVICE_URL=http://localhost:8085
STATISTICS_SERVICE_URL=http://localhost:8086

# `docker compose up` overrides these to the in-network service names
# (see docker-compose.yml) — you don't need to change them for that path.

# Required by auth-service itself, not by the gateway — but `docker compose
# up` here also starts auth-service, and its startup fails without one.
# Generate with: (cd ../beebase-auth-service && make keygen)
JWT_PRIVATE_KEY=change-me-run-make-keygen-in-beebase-auth-service

# Also required by auth-service, for the same reason as JWT_PRIVATE_KEY
# above: base64-encoded 32-byte AES-256 key used to encrypt TOTP (2FA)
# secrets at rest. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32

# Required by media-service itself, not by the gateway - but `docker
# compose up` here also starts media-service, and its startup fails
# without these. File content is stored in Cloudflare R2, not the
# database - see beebase-media-service's README Storage section and
# .env.example for details.
R2_ENDPOINT=https://<account-hash>.r2.cloudflarestorage.com
R2_BUCKET=beebase-development
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
